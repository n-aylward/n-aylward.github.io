---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { RESUME } from "@/data/resume";
import { CONTACTS } from "@/data/contacts";

// Include text versions of the contact links in print because the page
// uses icons for those links on screen.
const printContacts = CONTACTS.map(contact =>
  contact.href.replace(/^mailto:/, "").replace(/^https?:\/\/(www\.)?/, "")
);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section
      id="hero"
      class="border-b border-border py-10 font-mono print:border-none print:py-0 print:pb-2"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 class="text-4xl font-bold sm:text-5xl print:text-xl! print:mb-0.5">
            {RESUME.name}
          </h1>
          <p class="mt-1 text-xl font-medium text-accent print:mt-0 print:text-[11pt]!">
            {RESUME.title}
          </p>
          <p class="mt-2 hidden text-sm text-foreground/70 print:mt-1 print:block print:text-[8pt]">
            {printContacts.join("   ·   ")}
          </p>
        </div>
        <div class="flex flex-col items-start gap-2 print:hidden sm:flex-row sm:items-center">
          <a
            href={RESUME.downloads.pdf}
            class="inline-flex items-center gap-2 rounded-md border border-accent bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent transition hover:bg-accent hover:text-background"
            download
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
              />
            </svg>
            Download Resume
          </a>
        </div>
      </div>
      <p class="mt-6 font-app text-base leading-relaxed text-foreground/85 print:mt-2 print:text-[8.5pt] print:leading-[1.35]">
        {RESUME.introduction}
      </p>
    </section>

    <section
      id="skills"
      class="border-b border-border py-10 print:break-inside-avoid print:py-2"
    >
      <h2 class="mb-5 text-2xl font-semibold tracking-wide text-accent print:mb-1.5 print:text-[11.5pt]">
        Professional Skills
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 print:gap-1.5">
        <div class="rounded-lg border border-border bg-muted/30 p-5 print:p-1.5">
          <h3 class="mb-3 font-semibold text-foreground print:mb-1 print:text-[9pt]">
            Proficiency
          </h3>
          <div class="flex flex-wrap gap-2 print:gap-1">
            {RESUME.skills.proficiency.map(skill => (
              <span class="rounded-full border border-accent/40 bg-accent/10 px-3 py-1 text-sm text-foreground print:px-1.5 print:py-0.5 print:text-[7.5pt]">
                {skill}
              </span>
            ))}
          </div>
        </div>
        <div class="rounded-lg border border-border bg-muted/30 p-5 print:p-1.5">
          <h3 class="mb-3 font-semibold text-foreground print:mb-1 print:text-[9pt]">
            Familiarity
          </h3>
          <div class="flex flex-wrap gap-2 print:gap-1">
            {RESUME.skills.familiarity.map(skill => (
              <span class="rounded-full border border-border bg-muted/50 px-3 py-1 text-sm text-foreground print:px-1.5 print:py-0.5 print:text-[7.5pt]">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="experience" class="border-b border-border py-10 print:py-2">
      <h2 class="mb-8 text-2xl font-semibold tracking-wide text-accent print:mb-1.5 print:text-[11.5pt]">
        Work Experience
      </h2>

      <div class="space-y-10 print:space-y-1.5">
        {RESUME.experience.map(company => (
          <div>
            <div class="mb-1 flex flex-col print:break-after-avoid">
              <h3 class="text-lg font-bold print:text-[10pt]">
                {company.company}
              </h3>
              <span class="text-sm text-foreground/75 print:text-[8pt]">
                {company.dateRange}
              </span>
            </div>

            {company.roles.length > 1 ? (
              <div class="mt-3 space-y-5 border-l-2 border-border pl-5 print:mt-1 print:space-y-1.5 print:pl-2">
                {company.roles.map(role => (
                  <div class="print:break-inside-avoid">
                    <div class="flex flex-col">
                      <h4 class="text-sm font-semibold text-accent print:text-[9pt]">
                        {role.title}
                      </h4>
                      <span class="text-sm text-foreground/75 print:text-[8pt]">
                        {role.dateRange}
                      </span>
                    </div>
                    <ul class="mt-2 space-y-2 text-sm leading-relaxed print:mt-0.5 print:space-y-0 print:text-[8.5pt] print:leading-[1.28]">
                      {role.bullets.map(bullet => (
                        <li class="flex gap-2 print:gap-1">
                          <span
                            aria-hidden="true"
                            class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent print:mt-[0.5em] print:h-1 print:w-1"
                          ></span>
                          {bullet}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ) : (
              <>
                <h4 class="mb-3 text-sm font-semibold text-accent print:mb-1 print:text-[9pt]">
                  {company.roles[0].title}
                </h4>
                <ul class="space-y-2 text-sm leading-relaxed print:space-y-0 print:text-[8.5pt] print:leading-[1.28]">
                  {company.roles[0].bullets.map(bullet => (
                    <li class="flex gap-2 print:gap-1">
                      <span
                        aria-hidden="true"
                        class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent print:mt-[0.5em] print:h-1 print:w-1"
                      ></span>
                      {bullet}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        ))}
      </div>
    </section>

    <section id="education" class="py-10 print:py-2 print:pb-0">
      <h2 class="mb-6 text-2xl font-semibold tracking-wide text-accent print:mb-1.5 print:text-[11.5pt]">
        Education
      </h2>
      <div>
        <div class="mb-1 flex flex-col">
          <h3 class="text-lg font-bold print:text-[10pt]">
            {RESUME.education.institution}
          </h3>
          <span class="text-sm text-foreground/75 print:text-[8pt]">
            {RESUME.education.dateRange}
          </span>
        </div>
        <p class="mb-3 text-sm font-semibold text-accent print:mb-1 print:text-[9pt]">
          {RESUME.education.degree}
        </p>

        <div class="mt-5 rounded-lg border border-border bg-muted/30 p-5 print:mt-1.5 print:p-1.5">
          <h3 class="mb-3 font-semibold text-foreground print:mb-1 print:text-[9pt]">
            Relevant Coursework
          </h3>
          <div class="flex flex-wrap gap-2 print:gap-1">
            {RESUME.education.coursework.map(course => (
              <span class="rounded-full border border-border bg-muted/50 px-3 py-1 text-sm text-foreground print:px-1.5 print:py-0.5 print:text-[7.5pt]">
                {course}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
