---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { RESUME } from "@/data/resume";
import { CONTACTS } from "@/data/contacts";

// Include text versions of the contact links in print because the page
// uses icons for those links on screen.
const printContacts = CONTACTS.map(contact =>
  contact.href.replace(/^mailto:/, "").replace(/^https?:\/\/(www\.)?/, "")
);
const professionalExperience = RESUME.experience.filter(
  company => !company.additional
);
const additionalExperience = RESUME.experience.filter(
  company => company.additional
);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section
      id="hero"
      class="border-b border-border py-10 font-mono print:border-none print:py-0 print:pb-1.5"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 class="text-4xl font-bold sm:text-5xl print:text-[16.5pt]! print:mb-0.5">
            {RESUME.name}
          </h1>
          <p class="mt-1 text-2xl font-medium text-accent sm:text-3xl print:mt-0 print:text-[12.75pt]!">
            {RESUME.title}
          </p>
          <p class="mt-2 hidden text-sm text-foreground/70 print:mt-1 print:block print:text-[9.5pt]">
            {printContacts.join("   ·   ")}
          </p>
        </div>
        <div class="flex flex-col items-start gap-2 print:hidden sm:flex-row sm:items-center">
          <a
            href={RESUME.downloads.pdf}
            class="inline-flex items-center gap-2 rounded-md border border-accent bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent transition hover:bg-accent hover:text-background"
            download
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
              />
            </svg>
            Download Resume
          </a>
        </div>
      </div>
      <p class="mt-6 font-app text-sm leading-relaxed text-foreground/85 print:mt-2 print:text-[9.5pt] print:leading-[1.25]">
        {RESUME.introduction}
      </p>
    </section>

    <hr class="border-border" />
    <section class="border-b border-border py-10 print:pt-1.5 print:pb-2">
      <h2 class="mb-5 text-xl font-semibold tracking-wide text-accent print:mb-1 print:text-[11.25pt]">
        Areas of Expertise
      </h2>
      <p class="text-sm leading-relaxed text-foreground/85 print:text-[9.5pt] print:leading-[1.15]">
        {RESUME.areasOfExpertise.join("  |  ")}
      </p>
    </section>

    <section
      id="skills"
      class="border-b border-border py-8 print:pt-1 print:pb-1.5"
    >
      <h2 class="mb-5 text-xl font-semibold tracking-wide text-accent print:mb-1 print:text-[11.25pt]">
        Technical Proficiencies
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 print:hidden">
        <div class="rounded-lg border border-border bg-muted/30 p-5">
          <h3 class="mb-3 font-semibold text-foreground">Proficiency</h3>
          <div class="flex flex-wrap gap-2">
            {RESUME.skills.proficiency.map(skill => (
              <span class="rounded-full border border-accent/40 bg-accent/10 px-3 py-1 text-sm text-foreground">
                {skill}
              </span>
            ))}
          </div>
        </div>
        <div class="rounded-lg border border-border bg-muted/30 p-5">
          <h3 class="mb-3 font-semibold text-foreground">Familiarity</h3>
          <div class="flex flex-wrap gap-2">
            {RESUME.skills.familiarity.map(skill => (
              <span class="rounded-full border border-border bg-muted/50 px-3 py-1 text-sm text-foreground">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </div>
      <div class="hidden print:block print:text-[9.5pt] print:leading-[1.15]">
        <p>
          <span class="font-semibold">Proficiency: </span>
          {RESUME.skills.proficiency.join(", ")}
        </p>
        <p class="mt-0.5">
          <span class="font-semibold">Familiarity: </span>
          {RESUME.skills.familiarity.join(", ")}
        </p>
      </div>
    </section>

    <section
      id="experience"
      class="border-b border-border py-10 print:pt-1.5 print:pb-2"
    >
      <h2 class="mb-8 text-xl font-semibold tracking-wide text-accent print:mb-1 print:text-[11.25pt]">
        Professional Experience
      </h2>

      <div class="space-y-10 print:space-y-1.5">
        {professionalExperience.map((company, index) => (
          <div class:list={{ "print-page-break-before": index === 1 }}>
            <div class="mb-1 flex flex-col print:flex-row print:items-baseline print:justify-between print:break-after-avoid">
              <h3 class="text-lg font-bold print:text-[10.25pt]">
                {company.company}
                <span class="ml-2 font-mono text-sm font-normal text-foreground/70 print:text-[8.25pt]">
                  {company.location}
                </span>
              </h3>
              <span class="font-mono text-sm text-foreground/75 print:whitespace-nowrap print:text-[8.25pt]">
                {company.dateRange}
              </span>
            </div>

            {company.roles.length > 1 ? (
              <div class="mt-3 space-y-5 border-l-2 border-border pl-5 print:mt-1 print:space-y-1.5 print:pl-2">
                {company.roles.map(role => (
                  <div class="print:break-inside-avoid">
                    <div class="flex flex-col print:flex-row print:items-baseline print:justify-between">
                      <h4 class="text-base font-semibold text-accent print:text-[9.25pt]">
                        {role.title}
                      </h4>
                      <span class="font-mono text-sm text-foreground/75 print:whitespace-nowrap print:text-[8.25pt]">
                        {role.dateRange}
                      </span>
                    </div>
                    <ul class="resume-bullet-list mt-2 space-y-2 text-sm leading-relaxed print:mt-1.5 print:space-y-0 print:text-[9.5pt] print:leading-[1.08]">
                      {role.bullets.map(bullet => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ) : (
              <>
                <h4 class="mb-3 text-base font-semibold text-accent print:mb-1.5 print:text-[9.25pt]">
                  {company.roles[0].title}
                </h4>
                <ul class="resume-bullet-list space-y-2 text-sm leading-relaxed print:space-y-0 print:text-[9.5pt] print:leading-[1.08]">
                  {company.roles[0].bullets.map(bullet => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </>
            )}
          </div>
        ))}
      </div>
    </section>

    <section
      id="additional-experience"
      class="border-b border-border py-8 print:pt-1.5 print:pb-2"
    >
      <h2 class="mb-5 text-xl font-semibold tracking-wide text-accent print:mb-1 print:text-[11.25pt]">
        Additional Experience
      </h2>
      <div class="space-y-10 print:space-y-1.5">
        {additionalExperience.map(company => (
          <div>
            <div class="mb-1 flex flex-col print:flex-row print:items-baseline print:justify-between print:break-after-avoid">
              <h3 class="text-lg font-bold print:text-[10.25pt]">
                {company.company}
                <span class="ml-2 font-mono text-sm font-normal text-foreground/70 print:text-[8.25pt]">
                  {company.location}
                </span>
              </h3>
              <span class="font-mono text-sm text-foreground/75 print:whitespace-nowrap print:text-[8.25pt]">
                {company.dateRange}
              </span>
            </div>
            <h4 class="mb-3 text-base font-semibold text-accent print:mb-1.5 print:text-[9.25pt]">
              {company.roles[0].title}
            </h4>
            <ul class="resume-bullet-list space-y-2 text-sm leading-relaxed print:space-y-0 print:text-[9.5pt] print:leading-[1.08]">
              {company.roles[0].bullets.map(bullet => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="education" class="py-10 print:pt-1.5 print:pb-0">
      <h2 class="mb-6 text-xl font-semibold tracking-wide text-accent print:mb-1 print:text-[11.25pt]">
        Education
      </h2>
      <div>
        <div class="mb-1 flex flex-col print:flex-row print:items-baseline print:justify-between">
          <h3 class="text-lg font-bold print:text-[10.25pt]">
            {RESUME.education.institution}
          </h3>
          <span class="font-mono text-sm text-foreground/75 print:whitespace-nowrap print:text-[8.25pt]">
            {RESUME.education.dateRange}
          </span>
        </div>
        <p class="mb-3 text-sm font-semibold text-accent print:mb-1 print:text-[9.5pt]">
          {RESUME.education.degree}
        </p>

        <p class="mt-3 text-sm leading-relaxed text-foreground/85 print:mt-1 print:text-[9.5pt] print:leading-[1.15]">
          {RESUME.education.coursework.join(" · ")}
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
