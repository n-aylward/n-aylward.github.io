---
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { SITE } from "@/config";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4 print:hidden"
>
  Skip to content
</a>

<header class="app-layout flex flex-col items-center justify-between font-mono sm:flex-row print:hidden">
  <div
    id="top-nav-wrap"
    class:list={[
      "py-4 sm:py-6",
      "border-b border-border",
      "relative w-full bg-background",
      "flex items-baseline justify-between sm:items-center",
    ]}
  >
    <a
      href="/"
      class="absolute transition-opacity hover:opacity-80 sm:static sm:my-auto"
    >
      <img
        src="/assets/resume-favicon196.png"
        alt={SITE.author}
        class="h-8 w-8 object-contain sm:h-10 sm:w-10"
      />
    </a>
    {SITE.lightAndDarkMode && (
      <div class="flex w-full items-center justify-end sm:w-auto sm:ms-2">
        <button
          id="theme-btn"
          class="focus-outline relative size-10 p-2 sm:size-8"
          title="Toggles light & dark"
          aria-label="auto"
          aria-live="polite"
        >
          <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all hover:stroke-[var(--accent-other)] dark:scale-0 dark:-rotate-90" />
          <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all hover:stroke-[var(--accent-other)] dark:scale-100 dark:rotate-0" />
        </button>
      </div>
    )}
  </div>
</header>
