{
  "name": "n-aylward-resume",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "resume:docx": "tsx scripts/generate-resume-docx.mjs",
    "resume:pdf": "tsx scripts/generate-resume-pdf.mjs",
    "build": "npm run resume:docx && astro check && astro build && npm run resume:pdf && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.3.3",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "docx": "^9.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer": "^24.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "wrangler": "^4.133.0"
  },
  "overrides": {
    "fflate": "^0.8.3"
  }
}
